# Discord bot token — https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Spotify API — https://developer.spotify.com/dashboard → Client ID + Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional storage override. Defaults to ./data locally and /data in Docker.
# DATA_DIR=data

# Optional operator HTTP API (both port and token are required to enable it).
# WEB_PORT=8080
# WEB_API_TOKEN=replace-with-a-long-random-secret
# WEB_HOST=127.0.0.1

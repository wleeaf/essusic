# Discord bot token — https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Generate once: python -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Keep this key stable and back it up separately from data/. Losing it locks saved credentials.
CREDENTIALS_KEY=

# Public HTTPS origin. HTTP is accepted only for local self-hosting / an SSH tunnel.
WEB_BASE_URL=http://localhost:8080
WEB_PORT=8080
WEB_HOST=127.0.0.1

# Optional storage override. Defaults to ./data locally and /data in Docker.
# DATA_DIR=data

# Optional operator API; separate from owner setup and disabled without this token.
# WEB_API_TOKEN=replace-with-a-long-random-secret

# Music credentials are configured per server through /setup, never in this file.
